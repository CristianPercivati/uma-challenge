# Copiá este archivo a .env y completalo. .env no se sube a git.
# Solo hace falta para llamar a las APIs: con --extraccion el servicio corre sin GCP.

# Document AI: endpoint completo del procesador (Enterprise Document OCR)
DOCAI_ENDPOINT=https://us-documentai.googleapis.com/v1/projects/<PROYECTO>/locations/us/processors/<PROCESADOR>:process

# Vertex AI (solo para --llm)
GCP_PROJECT=<PROYECTO>
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Service account con permisos sobre Document AI y Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json
